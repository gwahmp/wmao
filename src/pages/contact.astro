  }

  <form
    method="GET"
    id="contact-form"
    class="mx-auto max-w-2xl space-y-5"
    data-wm-method="xT0awZ=="
    onsubmit="return false;"
    target="SBOUdl"
    action="about:blank"
    data-wm-protected="true">
    <div>
      <label
        for="contact-name"
        class="mb-2 block text-sm font-medium text-gray-900">
        Name
      </label>
      <input
        type="text"
        id="contact-name"
        required=""
        maxlength="100"
        autocomplete="name"
        placeholder="Your name"
        class="w-full px-4 py-1 bg-gray-50 border border-gray-300"
        data-wm-name="ynUgAJ=="
      />
    </div>

    <div>
      <label
        for="contact-email"
        class="mb-2 block text-sm font-medium text-gray-900">
        Email
      </label>
      <input
        type="email"
        id="contact-email"
        required=""
        maxlength="254"
        autocomplete="email"
        placeholder="you@example.com"
        class="w-full px-4 py-1 bg-gray-50 border border-gray-300"
        data-wm-name="AD8szDd="
      />
    </div>

    <div>
      <label
        for="contact-message"
        class="mb-2 block text-sm font-medium text-gray-900">
        Message
      </label>
      <textarea
        id="contact-message"
        required=""
        maxlength="5000"
        rows="6"
        placeholder="Write your message..."
        class="w-full px-4 py-1 bg-gray-50 border border-gray-300 resize-y"
        data-wm-name="yDEax7UmAJ=="></textarea>
    </div>
    <div class="wm-captcha"></div>

    <button type="submit" id="contact-submit" class="btn">
      Send Message
    </button>

    <p id="contact-status" class="hidden text-sm"></p>
  </form>

  <script
    is:inline
    src="https://cdn.jsdelivr.net/gh/wikimint/wm-captcha@v1.0.3/dist/wm-captcha.min.js"
    crossorigin="anonymous"></script>

  <script is:inline>
    const form = document.getElementById("contact-form");
    const submitButton = document.getElementById("contact-submit");
    const status = document.getElementById("contact-status");

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();

      const name = document.getElementById("contact-name").value.trim();
      const email = document.getElementById("contact-email").value.trim();
      const message = document.getElementById("contact-message").value.trim();

      if (!name || !email || !message) {
        showStatus("Please fill in all fields.", false);
        return;
      }

      submitButton.disabled = true;
      submitButton.textContent = "Sending...";
      status.classList.add("hidden");

      try {
        const response = await fetch(`https://api.wikimint.com/contact`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            name,
            email,
            message,
          }),
        });

        const result = await response.json();

        if (!response.ok) {
          throw new Error(result.error || "Failed to send your message.");
        }

        form.reset();
        showStatus("Your message has been sent successfully.", true);
      } catch (error) {
        console.error("Contact form error:", error);
        showStatus(
          error.message || "Unable to send your message. Please try again.",
          false,
        );
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = "Send Message";
      }
    });

    function showStatus(message, success) {
      status.textContent = message;
      status.className = `text-sm ${success ? "text-green-600" : "text-red-600"}`;
    }
  </script>

  <h2>Visit Wikimint: Your Source for Business and Technology Insights</h2>
  <p>
    Explore the world of business and technology innovation with Wikimint. Our
    headquarters is the hub for digital transformation, industry trends, and
    expert insights. Come meet the minds behind cutting-edge reports and
    features.
  </p>

  <iframe
    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3888.35356940523!2d80.25210767507609!3d12.949212687364112!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3a525d006a6e1c77%3A0xc0c9eae5cc4e153!2sWikimint!5e0!3m2!1sen!2sin!4v1756219298045!5m2!1sen!2sin"
    width="100%"
    height="450"
    style="border:0;"
    allowfullscreen=""
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"></iframe>

  <p>
    Located at <strong>Chennai, Tamil Nadu. India</strong>, our location is the
    nerve center for expert commentary on business strategies, technological
    breakthroughs, and market trends. For queries or online inquiries, we
    encourage to reach out online through the contact form.
  </p>

  <p>Note: The location mentioned in the map above is tentative only.</p>
</PageLayout>
