---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FeedPost from "../../components/feed/FeedPost.astro";
import posts from "../../data/feeds/posts.json";
import type { FeedPost as FeedPostData } from "../../data/feeds/types";

const allPosts = (posts as FeedPostData[])
  .slice()
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const initialPosts = allPosts.slice(0, 20);
const currentUrl = Astro.url.href;

const title = "Wikimint Feeds – Latest Money, Business & Marketing Insights";
const description = "Short, practical insights from Wikimint on money, investing, business, marketing, SEO and growth.";
---

<BaseLayout title={title} description={description} image="/assets/images/business-motivation-marketing-strategy-personal-finance-strategy.webp">
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        name: title,
        description,
        url: currentUrl,
        isPartOf: { "@type": "WebSite", name: "Wikimint", url: "https://wikimint.com" }
      })}
    />
  </Fragment>

  <section class="mx-auto max-w-3xl px-4 py-10">
    <header class="mb-10">
      <p class="text-sm font-semibold uppercase tracking-wide text-wmblue">Wikimint Feeds</p>
      <h1 class="mt-2 text-4xl font-bold tracking-tight">Latest insights, in a quick-read feed</h1>
      <p class="mt-4 text-lg leading-8 text-gray-600">
        Fresh short posts covering money, investing, business, marketing and growth. Expand any post to read the full update.
      </p>

      <nav class="mt-6 flex flex-wrap gap-2" aria-label="Feed categories">
        <a class="rounded-full border px-4 py-2 text-sm hover:bg-gray-50" href="/feeds/money">Money</a>
        <a class="rounded-full border px-4 py-2 text-sm hover:bg-gray-50" href="/feeds/business">Business</a>
        <a class="rounded-full border px-4 py-2 text-sm hover:bg-gray-50" href="/feeds/marketing">Marketing</a>
        <a class="rounded-full border px-4 py-2 text-sm hover:bg-gray-50" href="/feeds/investing">Investing</a>
      </nav>
    </header>

    <div id="feed-container">
      {initialPosts.map((post) => <FeedPost post={post} />)}
    </div>

    <div id="feed-status" class="py-8 text-center text-sm text-gray-500" aria-live="polite"></div>
  </section>
</BaseLayout>

<script>
  const container = document.querySelector<HTMLElement>("#feed-container");
  const status = document.querySelector<HTMLElement>("#feed-status");
  const initialCount = 20;
  const batchSize = 20;
  let posts: any[] = [];
  let offset = initialCount;
  let loading = false;

  function escapeHtml(value: string) {
    return value.replace(/[&<>'"]/g, (char) => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      "'": "&#39;",
      '"': "&quot;"
    }[char] ?? char));
  }

  function renderPost(post: any) {
    const date = new Date(`${post.date}T00:00:00Z`).toLocaleDateString("en-IN", {
      day: "numeric", month: "short", year: "numeric", timeZone: "UTC"
    });

    const categories = (post.categories ?? []).map((category: string) =>
      `<a class="hover:text-wmblue" href="/feeds/${encodeURIComponent(category)}">${escapeHtml(category)}</a>`
    ).join(", ");

    const image = post.image
      ? `<figure class="mt-5 overflow-hidden rounded-xl bg-gray-100">
          <img src="${escapeHtml(post.image.src)}" alt="${escapeHtml(post.image.alt)}" width="${post.image.width ?? 1200}" height="${post.image.height ?? 630}" loading="lazy" decoding="async" class="w-full h-auto">
        </figure>`
      : "";

    const paragraphs = (post.content ?? []).map((paragraph: string) => `<p>${escapeHtml(paragraph)}</p>`).join("");
    const links = (post.links ?? []).length
      ? `<div class="pt-3"><h3 class="text-base font-semibold">Related</h3><ul class="mt-2 list-disc pl-5 space-y-1">${post.links.map((link: any) => `<li><a class="text-wmblue hover:underline" href="${escapeHtml(link.href)}">${escapeHtml(link.text)}</a></li>`).join("")}</ul></div>`
      : "";

    return `<article id="${escapeHtml(post.slug)}" class="feed-post scroll-mt-24 border-b border-gray-200 py-8" itemscope itemtype="https://schema.org/Article">
      <meta itemprop="url" content="https://wikimint.com/feeds#${escapeHtml(post.slug)}">
      <meta itemprop="datePublished" content="${escapeHtml(post.date)}">
      <header>
        <div class="flex flex-wrap items-center gap-2 text-sm text-gray-500 mb-2"><time datetime="${escapeHtml(post.date)}" itemprop="datePublished">${date}</time><span aria-hidden="true">·</span><span>${categories}</span></div>
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight" itemprop="headline">${escapeHtml(post.title)}</h2>
        <p class="mt-3 text-gray-700 leading-7" itemprop="description">${escapeHtml(post.excerpt)}</p>
      </header>
      ${image}
      <details class="feed-details mt-5">
        <summary class="inline-flex cursor-pointer select-none items-center rounded-lg border border-gray-300 px-4 py-2 font-medium hover:bg-gray-50"><span class="read-more">Read more</span><span class="read-less">Read less</span></summary>
        <div class="mt-5 space-y-4 leading-7 text-gray-800" itemprop="articleBody">${paragraphs}${links}</div>
      </details>
      ${(post.tags ?? []).length ? `<footer class="mt-5 flex flex-wrap gap-2">${post.tags.map((tag: string) => `<span class="rounded-full bg-gray-100 px-3 py-1 text-xs text-gray-600">#${escapeHtml(tag)}</span>`).join("")}</footer>` : ""}
    </article>`;
  }

  async function loadMore() {
    if (loading || !container) return;
    if (!posts.length) {
      const response = await fetch("/data/feeds/posts.json");
      if (!response.ok) throw new Error("Unable to load feed data");
      posts = await response.json();
      posts.sort((a: any, b: any) => new Date(b.date).getTime() - new Date(a.date).getTime());
    }

    if (offset >= posts.length) {
      if (status) status.textContent = "You have reached the end of the feed.";
      observer.disconnect();
      return;
    }

    loading = true;
    const nextPosts = posts.slice(offset, offset + batchSize);
    container.insertAdjacentHTML("beforeend", nextPosts.map(renderPost).join(""));
    offset += nextPosts.length;
    loading = false;

    if (offset >= posts.length) {
      if (status) status.textContent = "You have reached the end of the feed.";
      observer.disconnect();
    }
  }

  const sentinel = document.createElement("div");
  sentinel.setAttribute("aria-hidden", "true");
  document.querySelector("#feed-status")?.before(sentinel);

  const observer = new IntersectionObserver((entries) => {
    if (entries.some((entry) => entry.isIntersecting)) loadMore().catch((error) => {
      console.error(error);
      if (status) status.textContent = "More posts could not be loaded. Please refresh the page.";
    });
  }, { rootMargin: "800px 0px" });

  observer.observe(sentinel);
</script>
