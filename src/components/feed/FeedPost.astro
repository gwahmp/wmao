---
import type { FeedPost as FeedPostData } from "../../data/feeds/types";

const { post } = Astro.props as { post: FeedPostData };
const formattedDate = new Date(`${post.date}T00:00:00Z`).toLocaleDateString("en-IN", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC"
});
---

<article
  id={post.slug}
  class="feed-post scroll-mt-24 border-b border-gray-200 py-8 first:pt-0"
  itemscope
  itemtype="https://schema.org/Article"
>
  <meta itemprop="url" content={`https://wikimint.com/feeds#${post.slug}`} />
  <meta itemprop="datePublished" content={post.date} />

  <header>
    <div class="flex flex-wrap items-center gap-2 text-sm text-gray-500 mb-2">
      <time datetime={post.date} itemprop="datePublished">{formattedDate}</time>
      <span aria-hidden="true">·</span>
      {post.categories.map((category, index) => (
        <span>
          {index > 0 && <span aria-hidden="true">, </span>}
          <a class="hover:text-wmblue" href={`/feeds/${category}`} itemprop="articleSection">
            {category}
          </a>
        </span>
      ))}
    </div>

    <h2 class="text-2xl md:text-3xl font-bold tracking-tight" itemprop="headline">
      {post.title}
    </h2>

    <p class="mt-3 text-gray-700 leading-7" itemprop="description">
      {post.excerpt}
    </p>
  </header>

  {post.image && (
    <figure class="mt-5 overflow-hidden rounded-xl bg-gray-100">
      <img
        src={post.image.src}
        alt={post.image.alt}
        width={post.image.width ?? 1200}
        height={post.image.height ?? 630}
        loading="lazy"
        decoding="async"
        class="w-full h-auto"
        itemprop="image"
      />
      {post.image.caption && (
        <figcaption class="px-4 py-2 text-xs text-gray-500">{post.image.caption}</figcaption>
      )}
    </figure>
  )}

  <details class="feed-details mt-5">
    <summary class="inline-flex cursor-pointer select-none items-center rounded-lg border border-gray-300 px-4 py-2 font-medium hover:bg-gray-50">
      <span class="read-more">Read more</span>
      <span class="read-less">Read less</span>
    </summary>

    <div class="mt-5 space-y-4 leading-7 text-gray-800" itemprop="articleBody">
      {post.content.map((paragraph) => <p>{paragraph}</p>)}

      {post.video && post.video.provider === "youtube" && post.video.id !== "VIDEO_ID_HERE" && (
        <div class="mt-6 aspect-video overflow-hidden rounded-xl bg-black">
          <iframe
            src={`https://www.youtube.com/embed/${post.video.id}`}
            title={post.video.title ?? post.title}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
            class="h-full w-full"
          ></iframe>
        </div>
      )}

      {post.links && post.links.length > 0 && (
        <div class="pt-3">
          <h3 class="text-base font-semibold">Related</h3>
          <ul class="mt-2 list-disc pl-5 space-y-1">
            {post.links.map((link) => (
              <li><a class="text-wmblue hover:underline" href={link.href}>{link.text}</a></li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </details>

  {post.tags && post.tags.length > 0 && (
    <footer class="mt-5 flex flex-wrap gap-2">
      {post.tags.map((tag) => (
        <span class="rounded-full bg-gray-100 px-3 py-1 text-xs text-gray-600">#{tag}</span>
      ))}
    </footer>
  )}
</article>

<style>
  .read-less { display: none; }
  details[open] .read-more { display: none; }
  details[open] .read-less { display: inline; }
</style>
